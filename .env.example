# URL pública da aplicação (usada em links de e-mail, OAuth callbacks, OAI-PMH e Crossref)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Caminho opcional do banco SQLite (padrão: ./data/ocs.db; use :memory: em testes)
# OCW_DB_PATH=./data/ocs.db

# Modo de demonstração (habilita atalhos de login demo na tela /login — manter false em produção)
OCW_DEMO_MODE=false

# Popula dados de exemplo automaticamente apenas se o banco estiver vazio (manter false em produção)
OCW_AUTO_SEED=false

# Configuração SMTP (exclusivamente via variáveis de ambiente; nunca gravar senha no banco)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Open Conference Werneckiana <no-reply@example.org>"

# Google OAuth 2.0 (opcional — botões aparecem em /login somente quando configurado)
# URI de redirecionamento: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ORCID OAuth 2.0 (opcional — botões aparecem em /login somente quando configurado)
# Em testes, use ORCID_USE_SANDBOX=true (https://sandbox.orcid.org)
# URI de redirecionamento: ${NEXT_PUBLIC_APP_URL}/api/auth/orcid/callback
ORCID_USE_SANDBOX=true
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
